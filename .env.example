# Drizzle
DATABASE_URL=local.db

# SvelteKit
ORIGIN=http://localhost:5173

# better-auth — required in Phase 2 (32+ characters)
BETTER_AUTH_SECRET=""

# Phase 2 — dev/CI auth bypass shim. Format: email:role[+role][,email:role…]
# Refused when NODE_ENV=production.
#
# When set, /login shows a "Dev impersonation" panel with one-click
# buttons for each configured persona — useful for testing role-gated
# routes locally without standing up SSO. Example covering all three
# roles:
#   DEV_AUTH_BYPASS=admin@test:admin,worker@test:cfd_worker,clinician@test:clinician,super@test:admin+cfd_worker
DEV_AUTH_BYPASS=

# Phase 2 — first-run admin bootstrap (only seeded when no users exist)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Phase 1
ATTACHMENTS_DIR=./attachments
MAX_UPLOAD_BYTES=26214400          # 25 MiB hard cap per file
ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png,image/heic,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
RATE_LIMIT_PER_IP=3                # submissions per window
RATE_LIMIT_WINDOW_MS=900000        # 15 min
LOG_LEVEL=info
NODE_ENV=development

# OCR — BC Gov Document Intelligence backend (set OCR_PROVIDER=bcgov-di to use)
BCGOV_DI_BASE_URL=
BCGOV_DI_API_KEY=
BCGOV_DI_WORKFLOW_SLUG=ocr-only-minimal

# Mailer — BC Gov Common Hosted Email Service (set MAIL_TRANSPORT=ches to use)
# Defaults: CHES_BASE_URL=https://ches.api.gov.bc.ca/api/v1
CHES_BASE_URL=https://ches.api.gov.bc.ca/api/v1
CHES_TOKEN_URL=
CHES_CLIENT_ID=
CHES_CLIENT_SECRET=

# BC Gov SSO (Keycloak OIDC). Leave SSO_ISSUER_URL empty to disable.
# Values come from the SSO/CYDB Submissions-installation-*.json files:
#   issuer = "${auth-server-url}/realms/${realm}"
#   clientId = resource (e.g. cydb-submissions-6444)
#   clientSecret = credentials.secret
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# CHEFS ingestion (overrides DB-stored config when set)
CHEFS_FORM_ID=
CHEFS_API_TOKEN=
CHEFS_VERSION=0
CHEFS_BASE_URL=https://submit.digital.gov.bc.ca
CHEFS_FILE_COMPONENTS=simplefile
CHEFS_API_PARAMS=
CHEFS_POLLER_ENABLED=
CHEFS_POLL_INTERVAL_MS=60000
