{
	"name": "cydb-submissions",
	"private": true,
	"version": "1.2.8",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"; husky || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed:mock": "node scripts/seed-mock-submissions.mjs",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"update": "npm update --allow-git=none"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.14.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/mocker": "5.0.5",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.1.3",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"better-auth": "~1.7.1",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"nanoid": "^6.0.2",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.5"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "~0.25.12"
		},
		"minimatch": "11.0.1"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,ts,svelte}": [
			"eslint --fix --no-warn-ignored",
			"prettier --write"
		],
		"*.{json,md,css,html,yaml,yml}": [
			"prettier --write"
		]
	}
}
